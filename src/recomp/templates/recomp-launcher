#!/bin/sh
# Generated by recomp. Runs the pinned recovery toolchain image.
# The image reference below is immutable; never replace it with a tag.
set -eu

IMAGE='{{IMAGE}}'

case "${RECOMP_OCI_RUNTIME-}" in
  docker|podman) RUNTIME=$(command -v "$RECOMP_OCI_RUNTIME" || true) ;;
  '') RUNTIME=$(command -v docker || command -v podman || true) ;;
  *) echo "RECOMP_OCI_RUNTIME must be docker or podman" >&2; exit 2 ;;
esac

if [ -z "${RUNTIME}" ]; then
  echo "no OCI runtime found: install docker or podman" >&2
  exit 2
fi

if [ -z "${RECOMP_TARGET-}" ] || [ ! -f "${RECOMP_TARGET}" ]; then
  echo "set RECOMP_TARGET to your own copy of the target file" >&2
  exit 2
fi

exec "${RUNTIME}" run --rm --network=none \
  --cap-drop=ALL --security-opt=no-new-privileges \
  --pids-limit=512 --memory=4g --cpus=2 \
  --read-only --tmpfs=/tmp:rw,exec,nosuid,nodev,size=256m \
  --workdir /workspace \
  -v "$(pwd):/workspace:rw" \
  -v "${RECOMP_TARGET}:/recomp/target:ro" \
  "${IMAGE}" "$@"
